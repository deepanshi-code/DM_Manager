PORT=4000
# Reply-time target. 3600 = 1 hour. Use 120 while demoing so chats go overdue quickly.
SLA_SECONDS=120
SCHEDULER_INTERVAL_SECONDS=10
REPLY_WINDOW_HOURS=24
# --- Login ---
# on  = agents sign in (required for real customers). Create accounts with: npm run agent -- add <name>
# off = demo mode: pick a name from AGENTS, no password. Only for fake/simulated data.
AUTH=on
SESSION_HOURS=12
# Names offered in demo mode (AUTH=off) only
AGENTS=Asha,Rohan,Meera
# Set when behind a tunnel/reverse proxy that terminates HTTPS (e.g. 1), so cookies get the Secure flag
TRUST_PROXY=

# --- Delivery ---
# simulated = fake delivery for demos; instagram = real Meta messaging API
SENDER=simulated
# Set to e.g. 0.1 to see how failed sends are handled
SIM_SEND_FAIL_RATE=0
# Webhook security (Meta app settings). Leave secret empty only in local dev.
IG_VERIFY_TOKEN=dev-verify-token
IG_APP_SECRET=
# --- Instagram API (needed when SENDER=instagram) --- see docs/INSTAGRAM_SETUP.md
# Long-lived access token for the business account. Secret: never commit it.
IG_ACCESS_TOKEN=
# The business account's Instagram user id ("me" works with Instagram Login tokens)
IG_USER_ID=me
# Check Meta's changelog for the current version before going live
IG_API_VERSION=v23.0
IG_GRAPH_HOST=https://graph.instagram.com
# Optional: use a real PostgreSQL server instead of embedded PGlite
# DATABASE_URL=postgres://user:pass@localhost:5432/dm_manager

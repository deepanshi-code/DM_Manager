{
  "name": "dm-manager",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "simulate": "npm run simulate -w server --",
    "generate-data": "npm run generate-data -w server",
    "test": "npm test -w server",
    "test:ml": "python -m unittest discover -s ml/tests",
    "agent": "npm run agent -w server --",
    "demo:reset": "npm run demo:reset -w server",
    "loadtest": "npm run loadtest -w server --",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "engines": {
    "node": ">=20"
  }
}
